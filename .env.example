PORT=3000
NODE_ENV=development

# AI Provider Configuration
AI_PROVIDER=groq
AI_FALLBACK_ORDER=cerebras,gemini
MAX_AI_CALLS_PER_RUN=5
AI_REQUEST_DELAY_MS=3000
AI_MAX_RETRIES=3
MIN_STORY_SCORE=65
MAX_APPROVED_POSTS_PER_RUN=3

# Groq Configuration (primary)
GROQ_API_KEY=
GROQ_MODEL=

# Cerebras Configuration (first fallback)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=

# Gemini Configuration (second fallback, optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_REQUEST_DELAY_MS=5000
GEMINI_MAX_RETRIES=3

# X Publishing Configuration
X_PUBLISHING_ENABLED=false
X_DRY_RUN=true
X_AUTH_MODE=oauth2
X_DUE_GRACE_MINUTES=30
X_CLIENT_ID=
X_CLIENT_SECRET=
X_ACCESS_TOKEN=
X_REFRESH_TOKEN=
X_ACCESS_TOKEN_EXPIRES_AT=
X_USER_ID=
MAX_POSTS_PER_RUN=1
